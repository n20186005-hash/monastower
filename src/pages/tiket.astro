---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import VisitNotice from '../components/VisitNotice.astro';
import {priceAnswer,hoursAnswer,admissionAnswer} from '../data/visit';

const title = 'Tiket Masuk Monas: Harga & Jam Buka';
const description = 'Tiket museum dan puncak Monas: referensi tarif Beritajakarta 2 Januari 2026, perbedaan jam listing dan fasilitas, kartu pembayaran, kuota dan hal yang perlu dikonfirmasi.';

const faqs = [
  {
    q: 'Berapa harga tiket masuk Monas untuk naik ke puncak?',
    a: priceAnswer
  },
  {
    q: 'Apakah masuk ke kawasan taman Monas gratis?',
    a: admissionAnswer
  },
  {
    q: 'Jam berapa Monas buka dan hari apa saja tutup?',
    a: hoursAnswer
  },
  {
    q: 'Bagaimana cara naik ke atas Monas?',
    a: 'Pelataran puncak berada pada ketinggian sekitar 115 meter dan dicapai dengan lift dari dasar tugu. Beli tiket puncak di loket resmi, ikuti antrean menuju lift, lalu nikmati panorama dari pelataran puncak. Antrean lebih panjang pada akhir pekan dan hari libur.'
  },
  {
    q: 'Di mana tiket Monas dibeli?',
    a: 'Laporan Beritajakarta 2 Januari 2026 menyebut JakCard atau kartu terbitan Bank DKI. Konfirmasikan kanal pembelian, kartu yang diterima, biaya kartu, cakupan tiket dan ketersediaan kuota melalui UPK Monas pada tanggal kunjungan.'
  },
  {
    q: 'Berapa lama antrean lift ke puncak Monas?',
    a: 'Tidak ada angka pasti karena bergantung pada hari dan jumlah pengunjung. Antrean terpanjang biasanya terjadi pada akhir pekan, hari libur, dan menjelang sore. Datang pada pagi hari setelah kawasan dibuka adalah cara paling aman bila Anda ingin menghindari antrean.'
  }
];
---

<ArticleLayout title={title} description={description} faqs={faqs} navLabel="Tiket Monas">
  <p class="eyebrow text-[var(--red)]">Tiket & jam buka</p>
  <h1 class="mt-4 font-display text-4xl leading-[1.05] sm:text-5xl">Tiket Monas 2026: referensi tarif &amp; pemeriksaan jadwal.</h1>
  <p class="mt-6 text-lg leading-8 text-[var(--muted)]">
    Kawasan luar, museum dan puncak memiliki akses dan layanan berbeda. Tarif di bawah hanya referensi dari laporan resmi 2 Januari 2026; jangan menganggapnya tarif atau jaminan kuota pada hari kunjungan Anda.
  </p>

  <VisitNotice />
  <h2 class="mt-14 font-display text-3xl">Jam listing dan layanan yang berbeda</h2>
  <div class="mt-5 overflow-hidden rounded-2xl border border-[var(--forest)]/10 bg-[var(--paper)]">
    <div class="grid grid-cols-2 gap-px bg-[var(--forest)]/10">
      <div class="bg-[var(--paper)] p-5"><p class="text-xs font-black uppercase tracking-[.18em] text-[var(--red)]">Hari</p></div>
      <div class="bg-[var(--paper)] p-5"><p class="text-xs font-black uppercase tracking-[.18em] text-[var(--red)]">Jam</p></div>
      <div class="bg-[var(--paper)] p-5 text-sm text-[var(--muted)]">Selasa–Minggu</div>
      <div class="bg-[var(--paper)] p-5 text-sm font-semibold">08.00–21.00 · listing Maps 19 Okt 2026</div>
      <div class="bg-[var(--paper)] p-5 text-sm text-[var(--muted)]">Senin</div>
      <div class="bg-[var(--paper)] p-5 text-sm font-semibold">Tutup</div>
      <div class="bg-[var(--paper)] p-5 text-sm text-[var(--muted)]">Tugu, museum & puncak</div>
      <div class="bg-[var(--paper)] p-5 text-sm font-semibold">Konfirmasi jadwal masing-masing</div>
    </div>
  </div>
  <p class="mt-4 text-xs leading-6 text-[var(--muted)]">Tabel ini merangkum listing Maps bertanggal, bukan jadwal tersendiri setiap fasilitas. Konfirmasikan jam taman, museum, loket dan pelataran puncak melalui operator.</p>

  <h2 class="mt-14 font-display text-3xl">Referensi tarif laporan 2 Januari 2026</h2>
  <div class="mt-5 overflow-hidden rounded-2xl border border-[var(--forest)]/10 bg-[var(--paper)]">
    <div class="grid gap-px bg-[var(--forest)]/10 sm:grid-cols-2">
      <div class="bg-[var(--paper)] p-6">
        <p class="text-xs font-bold uppercase tracking-[.2em] text-white/70">Pelataran puncak</p>
        <p class="mt-3 font-display text-4xl text-[var(--red)]">Rp24.000</p>
        <p class="mt-1 text-sm text-[var(--muted)]">dewasa</p>
        <div class="mt-5 space-y-2 border-t border-[var(--forest)]/10 pt-4 text-sm text-[var(--muted)]"><p>Mahasiswa · Rp13.000</p><p>Anak/pelajar · Rp6.000</p></div>
      </div>
      <div class="bg-[var(--paper)] p-6">
        <p class="text-xs font-bold uppercase tracking-[.2em] text-white/70">Museum / cawan</p>
        <p class="mt-3 font-display text-4xl text-[var(--red)]">Rp8.000</p>
        <p class="mt-1 text-sm text-[var(--muted)]">dewasa</p>
        <div class="mt-5 space-y-2 border-t border-[var(--forest)]/10 pt-4 text-sm text-[var(--muted)]"><p>Mahasiswa · Rp5.000</p><p>Anak/pelajar · Rp3.000</p></div>
      </div>
    </div>
  </div>

  <h2 class="mt-14 font-display text-3xl">Cara naik ke pelataran puncak Monas</h2>
  <ol class="mt-5 space-y-3 text-sm leading-7 text-[var(--muted)]">
    <li class="flex gap-3"><span class="font-black text-[var(--red)]">1</span><span>Masuk lewat pintu kawasan yang aktif, lalu ikuti penunjuk arah menuju dasar tugu (cawan).</span></li>
    <li class="flex gap-3"><span class="font-black text-[var(--red)]">2</span><span>Konfirmasikan loket, metode pembelian dan cakupan tiket pelataran puncak.</span></li>
    <li class="flex gap-3"><span class="font-black text-[var(--red)]">3</span><span>Ikuti antrean menuju lift; petugas mengatur kapasitas pengunjung per sesi naik.</span></li>
    <li class="flex gap-3"><span class="font-black text-[var(--red)]">4</span><span>Lift membawa Anda ke pelataran puncak pada ketinggian sekitar 115 meter, tempat panorama Jakarta terlihat.</span></li>
  </ol>
  <p class="mt-4 text-xs leading-6 text-[var(--muted)]">Akses ke puncak dapat ditutup sementara karena cuaca, perawatan, atau acara khusus. Periksa pengumuman resmi bila Anda datang khusus untuk naik ke atas.</p>

  <h2 class="mt-14 font-display text-3xl">Tips menghindari antrean</h2>
  <ul class="mt-5 space-y-3 text-sm leading-7 text-[var(--muted)]">
    <li class="flex gap-3"><span class="font-black text-[var(--red)]">1</span><span>Antrean lift ke pelataran puncak lebih panjang pada akhir pekan dan hari libur; datang pada pagi hari bila ingin memaksimalkan waktu.</span></li>
    <li class="flex gap-3"><span class="font-black text-[var(--red)]">2</span><span>Konfirmasikan cakupan tiket museum dan puncak agar tidak salah memilih produk.</span></li>
    <li class="flex gap-3"><span class="font-black text-[var(--red)]">3</span><span>Laporan 2 Januari 2026 menyebut JakCard atau kartu terbitan Bank DKI; konfirmasikan metode saat ini, pembelian kartu dan biaya tambahannya sebelum datang.</span></li>
    <li class="flex gap-3"><span class="font-black text-[var(--red)]">4</span><span>Cuaca panas di siang hari; kombinasi museum lalu puncak pada sore hari sering menjadi urutan yang nyaman.</span></li>
  </ul>

  <div class="mt-10 rounded-2xl border border-[var(--forest)]/10 bg-[var(--paper)] p-6 text-xs leading-6 text-[var(--muted)]">
    <strong class="text-[var(--forest)]">Catatan:</strong> tarif dan jam dapat berubah sewaktu-waktu. Informasi resmi terbaru tersedia pada kanal UPK Monas dan Pemerintah Provinsi DKI Jakarta.
  </div>

  <p class="mt-10"><a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-[var(--red)] transition hover:gap-3">← Kembali ke beranda</a></p>
</ArticleLayout>
