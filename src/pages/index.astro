    <script is:inline>
      // @ts-nocheck
      (function () {
        var links = Array.prototype.slice.call(document.querySelectorAll('a.scroll-link'));
        var map = links
          .map(function (a) { return { link: a, target: document.querySelector(a.getAttribute('href')) }; })
          .filter(function (x) { return x.target; });
        var onScroll = function () {
          var pos = window.scrollY + 140;
          var current = map.length ? map[0].target : null;
          map.forEach(function (item) { if (item.target.offsetTop <= pos) current = item.target; });
          map.forEach(function (item) { item.link.classList.toggle('nav-active', item.target === current); });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        var gallery = document.getElementById('galeri');
        if (gallery) {
          var imgs = gallery.querySelectorAll('.gallery-img');
          var overlay = document.createElement('div');
          overlay.className = 'lightbox';
          var frame = document.createElement('figure');
          var cap = document.createElement('figcaption');
          frame.appendChild(cap);
          overlay.appendChild(frame);
          document.body.appendChild(overlay);
          imgs.forEach(function (el) {
            var img = /** @type {HTMLImageElement} */ (el);
            img.addEventListener('click', function () {
              var old = frame.querySelector('img');
              if (old) old.remove();
              var big = document.createElement('img');
              big.src = img.currentSrc || img.src;
              big.alt = img.alt;
              frame.insertBefore(big, cap);
              cap.textContent = img.getAttribute('data-caption') || '';
              overlay.classList.add('open');
            });
          });
          overlay.addEventListener('click', function () { overlay.classList.remove('open'); });
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape') overlay.classList.remove('open'); });
        }
      })();
    </script>

